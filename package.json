{
  "name": "km",
  "version": "0.1.0",
  "description": "Knowledge Machine - The agentic work desk",
  "private": true,
  "type": "module",
  "catalog": {
    "react": "^19.2.3",
    "@types/react": "^19.2.7"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/km-tui/packages/*",
    "vendor/*"
  ],
  "bin": {
    "km": "./apps/km-cli/src/index.ts",
    "debug": "./scripts/debug"
  },
  "scripts": {
    "km": "bun run ./apps/km-cli/src/index.ts",
    "km:safe": "./scripts/km-safe.sh",
    "update-all": "bun upgrade && nix flake update && bun update && bun test",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write . --log-level warn",
    "codemod": "bun scripts/codemod.ts",
    "fix": "bun run codemod && bun run lint:fix && bun run format:fix",
    "test:fast": "bun test $(find packages apps vendor -name '*.test.ts' ! -name '*.slow.test.ts' ! -path '*/node_modules/*' 2>/dev/null)",
    "test:slow": "bun test $(find packages apps vendor -name '*.slow.test.ts' ! -path '*/node_modules/*' 2>/dev/null)",
    "test:mdtest": "bun run vendor/beorn-mdtest/src/index.ts $(find packages apps vendor -name '*.test.md' ! -path '*/node_modules/*' 2>/dev/null)",
    "test:mdtest:update": "bun run vendor/beorn-mdtest/src/index.ts --update $(find packages apps vendor -name '*.test.md' ! -path '*/node_modules/*' 2>/dev/null)",
    "test:all": "bun test $(find packages apps vendor -name '*.test.ts' ! -path '*/node_modules/*' 2>/dev/null) && bun run test:mdtest",
    "build:info": "bun scripts/generate-build-info.ts",
    "prebuild": "bun run build:info",
    "build": "bun build ./apps/km-cli/src/index.ts --outdir ./dist --target node",
    "storybook": "bun run apps/km-tui/packages/km-ink/tests/storybook.tsx",
    "chaos:fuzz": "bun ./scripts/chaos.ts fuzz",
    "chaos:reproduce": "bun ./scripts/chaos.ts reproduce",
    "chaos:report": "bun ./scripts/chaos.ts report",
    "release": "release-it"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@release-it/conventional-changelog": "^10.0.4",
    "@sinonjs/fake-timers": "^15.1.0",
    "@steipete/peekaboo": "^3.0.0-beta3",
    "@types/bun": "^1.3.6",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "eslint": "^9.39.2",
    "eslint-plugin-promise": "^7.2.1",
    "ink-testing-library": "^4.0.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.57.0",
    "prettier": "^3.8.0",
    "react-devtools-core": "^7.0.1",
    "release-it": "^19.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@types/debug": "^4.1.12",
    "chokidar": "^5.0.0",
    "debug": "^4.4.3",
    "reselect": "^5.1.1",
    "ulid": "2.4.0"
  }
}
