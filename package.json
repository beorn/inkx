{
  "name": "km",
  "version": "0.2.0",
  "description": "Knowledge Machine - The agentic work desk",
  "private": true,
  "type": "module",
  "catalog": {
    "react": "^19.2.3",
    "@types/react": "^19.2.7"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/km-tui/packages/*",
    "vendor/*"
  ],
  "overrides": {
    "chalkx": "$chalkx",
    "@beorn/flexx": "$@beorn/flexx",
    "zod": "^4.3.6"
  },
  "bin": {
    "km": "./apps/km-cli/src/index.ts",
    "debug": "./scripts/debug"
  },
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "km": "bun run ./apps/km-cli/src/index.ts",
    "km:strict": "INKX_STRICT=true bun run ./apps/km-cli/src/index.ts",
    "km:safe": "./scripts/km-safe.sh",
    "worktree": "bun vendor/beorn-tools/tools/worktree.ts",
    "accountly": "bun vendor/beorn-accountly/src/cli.ts",
    "recall": "bun vendor/beorn-tools/tools/recall.ts",
    "llm": "bun vendor/beorn-tools/tools/llm.ts",
    "refactor": "bun vendor/beorn-tools/tools/refactor.ts",
    "tap": "bun ./vendor/beorn-tap/src/cli/runner.ts",
    "update-all": "bun upgrade && nix flake update && bun update && bun test",
    "type-check": "tsc --noEmit",
    "lint": "find apps packages infra vendor -path '*/node_modules' -prune -o -path '*/dist' -prune -o \\( -name '*.ts' -o -name '*.tsx' \\) -print | xargs oxlint -c packages/km-infra/oxlint/config.json --type-aware",
    "lint:errors": "find apps packages infra vendor -path '*/node_modules' -prune -o -path '*/dist' -prune -o \\( -name '*.ts' -o -name '*.tsx' \\) -print | xargs oxlint -c packages/km-infra/oxlint/config.json --type-aware --quiet",
    "lint:fix": "find apps packages infra vendor -path '*/node_modules' -prune -o -path '*/dist' -prune -o \\( -name '*.ts' -o -name '*.tsx' \\) -print | xargs oxlint -c packages/km-infra/oxlint/config.json --type-aware --fix",
    "lint:unused": "knip",
    "lint:complexity": "bun scripts/complexity-report.ts",
    "generate:knip": "bun packages/km-infra/knip/generate.ts --write",
    "format": "oxfmt -c packages/km-infra/oxfmt/config.json --check apps packages infra vendor",
    "format:fix": "oxfmt -c packages/km-infra/oxfmt/config.json --write apps packages infra vendor",
    "codemod": "bun scripts/codemod.ts",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "type:coverage": "type-coverage --detail --at-least 90",
    "fix": "bun run codemod && bun run lint:fix && bun run format:fix",
    "vitest": "bunx --bun vitest",
    "test:fast": "bash infra/test-perf/check-timing.sh bun vitest run --exclude='**/*.slow.*' --exclude='vendor/**'",
    "test:changed": "bun vitest run --changed --exclude='**/*.slow.*' --exclude='vendor/**'",
    "test:strict": "INKX_STRICT=1 bun vitest run",
    "test:fast2": "bun vitest run --exclude='**/*.slow.*' --reporter=vitestx/dotz",
    "test:slow": "bun vitest run -- '**/*.slow.{test,spec}.{ts,tsx,md}'",
    "test:all": "bun vitest run",
    "test:fuzz": "FUZZ=1 bun vitest run",
    "test:fuzz:ci": "FUZZ=1 FUZZ_REPEATS=10000 bun vitest run",
    "test:dotz": "bun vitest run --reporter=vitestx/dotz",
    "test:vendor": "bun vitest run -- 'vendor/**'",
    "test:fast:serial": "bun vitest run --exclude='**/*.slow.*' --sequence.concurrent=false --sequence.shuffle=false",
    "test:fast:html": "bun vitest run --reporter=html --reporter=junit --exclude='**/*.slow.*' && bun infra/test-perf/track.ts",
    "test:all:html": "bun vitest run --reporter=html --reporter=junit && bun infra/test-perf/track.ts",
    "bench": "bun vitest bench --reporter=default",
    "bench:baseline": "bun vitest bench --reporter=default --outputJson benchmarks/baseline.json",
    "bench:compare": "bun vitest bench --reporter=default --compare benchmarks/baseline.json",
    "build:info": "bun scripts/generate-build-info.ts",
    "prebuild": "bun run build:info",
    "build": "bun build ./apps/km-cli/src/index.ts --outdir ./dist --target node",
    "storybook": "bun run apps/km-tui/tests/storybook.tsx",
    "release": "release-it",
    "test:flexx:yoga": "cd vendor/beorn-flexx && bun test:yoga"
  },
  "devDependencies": {
    "@beorn/flexx": "workspace:*",
    "@beorn/inkx-ui": "workspace:*",
    "@beorn/logger": "workspace:*",
    "@beorn/mdtest": "workspace:*",
    "@beorn/tap": "workspace:*",
    "@beorn/watcher-chaos": "workspace:*",
    "@km/agent": "workspace:*",
    "@km/beads": "workspace:*",
    "@km/board": "workspace:*",
    "@km/cli-app": "workspace:*",
    "@km/commands": "workspace:*",
    "@km/connector-caldav": "workspace:*",
    "@km/core": "workspace:*",
    "@km/markdown": "workspace:*",
    "@km/repl": "workspace:*",
    "@km/storage": "workspace:*",
    "@km/tree": "workspace:*",
    "@km/tui": "workspace:*",
    "@playwright/test": "^1.58.2",
    "@release-it/conventional-changelog": "^10.0.5",
    "@sinonjs/fake-timers": "^15.1.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.8",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "@types/turndown": "^5.0.6",
    "chalkx": "workspace:*",
    "inkx": "workspace:*",
    "knip": "^5.83.1",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0",
    "oxlint-plugin-complexity": "^1.0.0",
    "oxlint-tsgolint": "^0.11.5",
    "playwright": "^1.58.2",
    "react": "^19.2.4",
    "release-it": "^19.2.4",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vitestx": "workspace:*",
    "yaml": "^2.8.2",
    "yoga-wasm-web": "^0.3.3"
  },
  "dependencies": {
    "@types/debug": "^4.1.12",
    "chokidar": "^5.0.0",
    "chrono-node": "^2.9.0",
    "debug": "^4.4.3",
    "rrule": "^2.8.1",
    "turndown": "^7.2.2",
    "ulid": "^3.0.2"
  }
}
