{
  "name": "km",
  "version": "0.1.0",
  "description": "Knowledge Machine - The agentic work desk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "vendor/*"
  ],
  "bin": {
    "km": "./apps/km-cli/src/index.ts"
  },
  "scripts": {
    "km": "bun run ./apps/km-cli/src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write . --log-level warn",
    "codemod": "bun scripts/codemod.ts",
    "fix": "bun run codemod && bun run lint:fix && bun run format:fix",
    "test": "bun test",
    "test:e2e": "bun run vendor/beorn-mdtest/src/index.ts tests/*.test.md",
    "test:e2e:update": "bun run vendor/beorn-mdtest/src/index.ts --update tests/*.test.md",
    "build": "bun build ./apps/km-cli/src/index.ts --outdir ./dist --target node",
    "storybook": "bun run apps/km-cli/tests/tui/storybook.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@steipete/peekaboo": "^3.0.0-beta3",
    "@types/bun": "^1.3.6",
    "eslint": "^9.39.2",
    "eslint-plugin-promise": "^7.2.1",
    "ink-testing-library": "^4.0.0",
    "node-pty": "^1.1.0",
    "prettier": "^3.7.4",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  }
}
