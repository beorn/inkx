{
  "name": "km",
  "version": "0.1.0",
  "description": "Knowledge Machine - The agentic work desk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/km-tui/packages/*",
    "vendor/*"
  ],
  "bin": {
    "km": "./apps/km-cli/src/index.ts"
  },
  "scripts": {
    "km": "bun run ./apps/km-cli/src/index.ts",
    "km:safe": "./scripts/km-safe.sh",
    "update-all": "bun upgrade && nix flake update && bun update && bun test",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write . --log-level warn",
    "codemod": "bun scripts/codemod.ts",
    "fix": "bun run codemod && bun run lint:fix && bun run format:fix",
    "test:fast": "bun test $(find packages apps vendor -name '*.test.ts' ! -name '*.slow.test.ts' ! -path '*/node_modules/*' 2>/dev/null)",
    "test:slow": "bun test $(find . -name '*.slow.test.ts' ! -path '*/node_modules/*' 2>/dev/null)",
    "test:mdtest": "bun run vendor/beorn-mdtest/src/index.ts $(find . -name '*.test.md' ! -path '*/node_modules/*' 2>/dev/null)",
    "test:mdtest:update": "bun run vendor/beorn-mdtest/src/index.ts --update $(find . -name '*.test.md' ! -path '*/node_modules/*' 2>/dev/null)",
    "test:all": "bun test && bun run test:mdtest",
    "build": "bun build ./apps/km-cli/src/index.ts --outdir ./dist --target node",
    "storybook": "bun run apps/km-tui/packages/km-ink/tests/storybook.tsx",
    "storybook2": "bun run apps/km-tui/packages/km-opentui/src/test-mock.tsx"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@steipete/peekaboo": "^3.0.0-beta3",
    "@types/bun": "^1.3.6",
    "eslint": "^9.39.2",
    "eslint-plugin-promise": "^7.2.1",
    "ink-testing-library": "^4.0.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.57.0",
    "prettier": "^3.8.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  },
  "dependencies": {
    "@opentui/core": "^0.1.73",
    "@opentui/react": "^0.1.73"
  }
}
