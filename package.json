{
  "name": "km",
  "version": "0.3.0",
  "description": "Knowledge Machine - The agentic work desk",
  "private": true,
  "type": "module",
  "catalog": {
    "react": "^19.2.3",
    "@types/react": "^19.2.7"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/km-tui/packages/*",
    "vendor/*",
    "vendor/termless/packages/*",
    "vendor/silvery/packages/*",
    "vendor/bearly/packages/*"
  ],
  "overrides": {
    "silvery": "$silvery",
    "@silvery/ag": "$@silvery/ag",
    "@silvery/ag-react": "$@silvery/ag-react",
    "@silvery/ag-term": "$@silvery/ag-term",
    "@silvery/ansi": "$@silvery/ansi",
    "@silvery/color": "$@silvery/color",
    "@silvery/create": "$@silvery/create",
    "@silvery/headless": "$@silvery/headless",
    "@silvery/commands": "$@silvery/commands",
    "@silvery/scope": "$@silvery/scope",
    "@silvery/signals": "$@silvery/signals",
    "@silvery/model": "$@silvery/model",
    "@silvery/theme": "$@silvery/theme",
    "@silvery/test": "$@silvery/test",
    "@silvery/commander": "$@silvery/commander",
    "@silvery/selection": "$@silvery/selection",
    "flexily": "$flexily",
    "loggily": "$loggily",
    "@termless/core": "$@termless/core",
    "@termless/xtermjs": "$@termless/xtermjs",
    "vimonkey": "$vimonkey",
    "vt100.js": "file:vendor/vterm/packages/vt100",
    "vt220.js": "file:vendor/vterm/packages/vt220",
    "vterm.js": "file:vendor/vterm/packages/vterm",
    "vitepress-enrich": "$vitepress-enrich",
    "zod": "^4.3.6"
  },
  "bin": {
    "km": "./apps/km-cli/src/index.ts",
    "km-logview": "./apps/km-logview/src/bootstrap.ts",
    "km-agent-view": "./apps/km-agent-view/src/bootstrap.ts",
    "debug": "./scripts/debug"
  },
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "km": "bun run ./apps/km-cli/src/index.ts",
    "km-logview": "bun run ./apps/km-logview/src/bootstrap.ts",
    "claude-log": "bun run ./apps/km-logview/src/claude-log.ts",
    "km-agent-view": "bun run ./apps/km-agent-view/src/bootstrap.ts",
    "silvercode": "bun run ./apps/silvercode/src/bootstrap.ts",
    "km:strict": "SILVERY_STRICT=true bun run ./apps/km-cli/src/index.ts",
    "km:safe": "./scripts/km-safe.sh",
    "termless": "bun vendor/termless/packages/cli/src/cli.ts",
    "silvery": "bun vendor/silvery/bin/silvery.ts",
    "design": "bun vendor/silvery/examples/bin/cli.ts design",
    "terminfo": "bun vendor/terminfo.dev/packages/admin/src/index.ts",
    "worktree": "bun vendor/bearly/tools/worktree.ts",
    "accountly": "bun vendor/accountly/src/cli.ts",
    "recall": "bun vendor/bearly/tools/recall.ts",
    "retrieve-memory": "bun tools/retrieve-memory.ts",
    "tribe": "bun vendor/bearly/tools/tribe-cli.ts",
    "tribe-retro": "bun vendor/bearly/tools/tribe-retro.ts",
    "llm": "bun vendor/bearly/tools/llm.ts",
    "refactor": "bun vendor/bearly/tools/refactor.ts",
    "sop": "bun tools/sop.ts",
    "sop-runner": "bun tools/sop-runner.ts",
    "tap": "bun ./vendor/tap/src/cli/runner.ts",
    "update-all": "bun upgrade && nix flake update && bun update && bun test",
    "lint": "bash packages/km-infra/scripts/lint.sh",
    "lint:errors": "bash packages/km-infra/scripts/lint.sh --quiet",
    "lint:fix": "bash packages/km-infra/scripts/lint.sh --fix",
    "lint:unused": "knip",
    "lint:workspace": "bash packages/km-infra/scripts/lint-workspace.sh",
    "lint:deps": "packages/km-infra/node_modules/.bin/depcruise packages/ apps/ --config packages/km-infra/depcruise/config.cjs",
    "lint:complexity": "bun scripts/complexity-report.ts",
    "generate:knip": "bun packages/km-infra/knip/generate.ts --write",
    "format": "oxfmt --check apps packages vendor",
    "format:fix": "oxfmt --write apps packages vendor",
    "codemod": "bun scripts/codemod.ts",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "typecheck:check": "bash packages/km-infra/scripts/typecheck/check.sh",
    "typecheck:update": "bash packages/km-infra/scripts/typecheck/update-baseline.sh",
    "lint:types": "NODE_OPTIONS='--max-old-space-size=16384' type-coverage --at-least 85 --strict --project tsconfig.type-coverage.json",
    "lint:links": "find docs -name '*.md' | xargs markdown-link-check --quiet --config .markdown-link-check.json",
    "fix": "bun run codemod && bun run lint:fix && bun run format:fix && bun tools/lint-injection-emitters.ts",
    "vitest": "bunx --bun vitest",
    "test:fast": "bash packages/km-infra/scripts/typecheck/check.sh && bun vitest run",
    "test:changed": "bun vitest run --changed",
    "test:slow": "bun vitest run --project slow",
    "test:all": "bun vitest run --project default --project slow --project vendor --project fuzz",
    "test:vendor": "bun vitest run --project vendor",
    "test:compat": "cd vendor/silvery && bun run compat",
    "test:compat:ink": "cd vendor/silvery && bun run compat:ink",
    "test:compat:chalk": "cd vendor/silvery && bun run compat:chalk",
    "test:fuzz": "bun vitest run --project fuzz",
    "test:ci": "bash packages/km-infra/scripts/typecheck/check.sh && bun fix && bun tools/lint-claude-config.ts && bun tools/lint-injection-emitters.ts && bash packages/km-infra/scripts/check-test-patterns.sh && bash packages/km-infra/scripts/check-no-publish-private.sh && bash packages/km-infra/scripts/check-stdin-ownership.sh && bun vitest run && bun vitest run --project slow && bun vitest run --project vendor && bun vitest run --project fuzz && bun vitest run --project prototype",
    "test:prototype": "bun vitest run --project prototype",
    "test:strictest": "SILVERY_STRICT=2 bash packages/km-infra/scripts/typecheck/check.sh && bun fix && bun vitest run && bun vitest run --project slow && bun vitest run --project vendor",
    "test:fast:serial": "bun vitest run --sequence.concurrent=false --sequence.shuffle=false",
    "test:fast:html": "bun vitest run --reporter=html --reporter=junit && bun packages/km-infra/scripts/test-perf/track.ts",
    "test:all:html": "bun vitest run --project default --project slow --project vendor --reporter=html --reporter=junit && bun packages/km-infra/scripts/test-perf/track.ts",
    "bench": "SILVERY_STRICT=0 bun vitest bench --reporter=default && touch benchmarks/results/.last-bench",
    "bench:check": "bun scripts/bench-staleness.ts",
    "bench:baseline": "SILVERY_STRICT=0 bun vitest bench --reporter=default --outputJson benchmarks/baseline.json",
    "bench:compare": "SILVERY_STRICT=0 bun vitest bench --reporter=default --compare benchmarks/baseline.json",
    "perf:startup": "hyperfine --warmup 3 --min-runs 10 'bun km --help' --export-json /tmp/km-startup-bench.json",
    "audit:supply-chain": "bunx socket scan create . --org beorn --json",
    "build:info": "bun scripts/generate-build-info.ts",
    "prebuild": "bun run build:info",
    "build": "bun build ./apps/km-cli/src/index.ts --outdir ./dist --target node",
    "storybook": "bun run apps/km-tui/tests/storybook.tsx",
    "release": "bun .claude/skills/release/release.ts",
    "npm-registry": "bun .claude/skills/npm/registry.ts",
    "test:flexily:yoga": "cd vendor/flexily && bun test:yoga"
  },
  "devDependencies": {
    "@beorn/tap": "workspace:*",
    "@beorn/watcher-chaos": "workspace:*",
    "@km/agent": "workspace:*",
    "@km/beads": "workspace:*",
    "@km/board": "workspace:*",
    "@km/cli-app": "workspace:*",
    "@km/commands": "workspace:*",
    "@km/connector-caldav": "workspace:*",
    "@km/core": "workspace:*",
    "@km/fs-mount": "workspace:*",
    "@km/markdown": "workspace:*",
    "@km/repl": "workspace:*",
    "@km/storage": "workspace:*",
    "@km/tree": "workspace:*",
    "@km/tui": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@silvery/ag-react": "workspace:*",
    "@silvery/ag-term": "workspace:*",
    "@silvery/ansi": "workspace:*",
    "@silvery/commander": "workspace:*",
    "@silvery/commands": "workspace:*",
    "@silvery/create": "workspace:*",
    "@silvery/headless": "workspace:*",
    "@silvery/model": "workspace:*",
    "@silvery/scope": "workspace:*",
    "@silvery/signals": "workspace:*",
    "@silvery/test": "workspace:*",
    "@silvery/theme": "workspace:*",
    "@sinonjs/fake-timers": "^15.3.2",
    "@termless/alacritty": "workspace:*",
    "@termless/core": "workspace:*",
    "@termless/ghostty": "workspace:*",
    "@termless/ghostty-native": "workspace:*",
    "@termless/test": "workspace:*",
    "@termless/vt100": "workspace:*",
    "@termless/vterm": "workspace:*",
    "@termless/wezterm": "workspace:*",
    "@termless/xtermjs": "workspace:*",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.12",
    "@types/jscodeshift": "^17.3.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "@vitest/ui": "^4.1.4",
    "alien-signals": "^3.1.2",
    "boxen": "^8.0.1",
    "flexily": "workspace:*",
    "ink": "^7.0.0",
    "knip": "^5.88.1",
    "loggily": "workspace:*",
    "markdown-link-check": "^3.14.2",
    "oxfmt": "^0.38.0",
    "oxlint": "^1.59.0",
    "oxlint-plugin-complexity": "^2.1.1",
    "oxlint-tsgolint": "^0.16.0",
    "pino": "^10.3.1",
    "playwright": "^1.59.1",
    "react": "^19.2.5",
    "react-devtools-core": "^7.0.1",
    "silvery": "workspace:*",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.3",
    "vimonkey": "workspace:*",
    "vitest": "^4.1.4",
    "vitest-silvery-dots": "workspace:*",
    "winston": "^3.19.0",
    "ws": "^8.20.0",
    "yaml": "^2.8.3",
    "yoga-wasm-web": "^0.3.3"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.3",
    "@types/debug": "^4.1.13",
    "chokidar": "^5.0.0",
    "chrono-node": "^2.9.0",
    "commander": "^14.0.3",
    "debug": "^4.4.3",
    "entities": "^8.0.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-mdast": "^10.1.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-gfm": "^3.0.0",
    "rehype-parse": "^9.0.1",
    "rrule": "^2.8.1",
    "ulid": "^3.0.2",
    "zod": "^4.3.6"
  }
}
