{
  "name": "km",
  "version": "0.1.0",
  "description": "Knowledge Machine - The agentic work desk",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "km": "./apps/km-cli/src/index.ts"
  },
  "scripts": {
    "km": "bun run ./apps/km-cli/src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write . --log-level warn",
    "codemod": "bun scripts/codemod.ts",
    "fix": "bun run codemod && bun run lint:fix && bun run format:fix",
    "test": "bun test",
    "build": "bun build ./apps/km-cli/src/index.ts --outdir ./dist --target node"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "eslint": "^9.39.2",
    "eslint-plugin-promise": "^7.2.1",
    "ink-testing-library": "^4.0.0",
    "node-pty": "^1.1.0",
    "prettier": "^3.7.4",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  }
}
