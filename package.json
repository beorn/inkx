{
  "name": "km",
  "version": "0.1.0",
  "description": "Knowledge Machine - The agentic work desk",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "bin": {
    "km": "./src/cli/index.ts"
  },
  "scripts": {
    "km": "bun run ./src/cli/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write . --log-level warn",
    "codemod": "bun scripts/codemod.ts",
    "fix": "bun run codemod && bun run lint:fix && bun run format:fix",
    "test": "bun test",
    "build": "bun build ./src/cli/index.ts --outdir ./dist --target node"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/bun": "^1.3.4",
    "@types/react": "^19.2.7",
    "eslint": "^9.39.2",
    "eslint-plugin-promise": "^7.2.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.7.4",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0",
    "fullscreen-ink": "^0.1.0",
    "ink": "^6.6.0",
    "ink-select-input": "^6.2.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "react": "^19.2.3",
    "ulid": "^2.3.0",
    "yaml": "^2.7.1"
  }
}
