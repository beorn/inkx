{
  "name": "@km/agent-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Typed harness for spawning Claude Code (and other agent CLIs) with stream-json. Used by silvercode.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./parse": "./src/parse.ts",
    "./events": "./src/events.ts",
    "./spawn": "./src/spawn.ts",
    "./injectors": "./src/injectors.ts",
    "./event-log": "./src/event-log.ts",
    "./session-store": "./src/session-store.ts",
    "./sdk-adapter": "./src/sdk-adapter.ts",
    "./codex-spawn": "./src/codex-spawn.ts",
    "./acp-types": "./src/acp-types.ts",
    "./acp-boundary": "./src/acp-boundary.ts",
    "./acp-client": "./src/acp-client.ts",
    "./acp-session": "./src/acp-session.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.20.0",
    "@silvery/scope": "workspace:*",
    "alien-projections": "workspace:*",
    "alien-signals": "^3.1.2",
    "alien-trees": "workspace:*",
    "debug": "^4.4.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12"
  }
