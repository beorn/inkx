mdtest:
  plugin: ../mdtest-sh-plugin.ts
---

# km sh - Path Navigation Tests

Tests for path-based navigation commands using `km sh`.

## Setup

```console
$ beforeAll() {
>   export TEST_ROOT="$(mktemp -d)"
>   cd "$TEST_ROOT"
>   km() { bun run "$ROOT/apps/km-cli/src/index.ts" "$@"; }
>   export -f km
>   mkdir -p .km
> }
$ afterAll() {
>   rm -rf "$TEST_ROOT"
> }
```

Create a test board with multiple sections and tasks:

```console
$ cat > board.md << 'EOF'
> # Test Board
> ## Section A
> - [ ] Task A1
> - [ ] Task A2
> - [ ] Task A3
> ## Section B
> - [ ] Task B1
> - [ ] Task B2
> EOF
```

```console
$ km sync
Syncing .km/state.db with files (repo ...)
[...]
✓ Synced ... change(s) in ... directories (...ms)
```

## Path Navigation Tests

All path-based navigation tests using persistent bash subprocess:

```console cmd="bash --norc --noprofile" minWait=50 maxWait=1000
$ PS1='' PS2=''
$ stty -echo
$ km sh board.md -c 'state'
cursor: [0,0]
node: Task A1
topLevel: 2 nodes
$ km sh board.md -c 'nav_to_path 1; state'
cursor: [1]
node: Section B
topLevel: 2 nodes
$ km sh board.md -c 'nav_to_path 0,1; state'
cursor: [0,1]
node: Task A2
topLevel: 2 nodes
$ km sh board.md -c 'nav_to_path 1,0; state'
cursor: [1,0]
node: Task B1
topLevel: 2 nodes
$ km sh board.md -c 'nav_to_path'
error: nav_to_path requires a path argument
$ km sh board.md -c 'nav_to_path a,b,c'
error: nav_to_path requires comma-separated numeric indices
$ km sh board.md -c 'select_position 0,2; state'
cursor: [0,2]
node: Task A3
topLevel: 2 nodes
$ km sh board.md -c 'cursor_next; state'
cursor: [0,1]
node: Task A2
topLevel: 2 nodes
$ km sh board.md -c 'cursor_next; cursor_prev; state'
cursor: [0,0]
node: Task A1
topLevel: 2 nodes
$ km sh board.md -c 'h; cursor_in; state'
cursor: [0,0]
node: Task A1
topLevel: 2 nodes
$ km sh board.md -c 'nav_to_path 1; cursor_in; state'
cursor: [1,0]
node: Task B1
topLevel: 2 nodes
$ km sh board.md -c 'cursor_out; state'
cursor: [0]
node: Section A
topLevel: 2 nodes
$ km sh board.md -c 'h; state'
cursor: [0]
node: Section A
topLevel: 2 nodes
$ km sh board.md -c 'h; l; state'
cursor: [0,0]
node: Task A1
topLevel: 2 nodes
$ km sh board.md -c 'h; h; state'
cursor: [0]
node: Section A
topLevel: 2 nodes
$ km sh board.md -c 'l; state'
cursor: [0,0]
node: Task A1
topLevel: 2 nodes
$ km sh board.md -c 'h; cursor_next; state'
cursor: [1]
node: Section B
topLevel: 2 nodes
```
