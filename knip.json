{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [".claude/**", "archive/**"],
  "bun": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "packages/km-storage/tests/sync/chaos/fuzzer.ts"]
    },
    "packages/km-board": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-commands": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-core": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-markdown": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-query": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-storage": {
      "entry": ["src/index.ts", "tests/**/*.test.ts", "tests/**/*.slow.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-tree": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "apps/km-cli": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "apps/km-repl": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "apps/km-tui": {
      "entry": ["src/index.ts", "src/tui.ts", "tests/**/*.test.ts", "tests/**/*.slow.test.ts", "tests/storybook.tsx"],
      "project": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"]
    },
    "apps/km-tui/packages/flexx": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "apps/km-tui/packages/km-ink": {
      "entry": ["src/index.ts", "tests/**/*.test.tsx"],
      "project": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.tsx"]
    },
    "vendor/beorn-logger": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "vendor/beorn-mdtest": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  }
}
