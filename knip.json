{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [".claude/**", "archive/**"],
  "bun": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "packages/km-storage/tests/sync/chaos/fuzzer.ts"
      ]
    },
    "apps/km-cli": {
      "entry": [
        "src/index.ts",
        "tests/**/*.test.ts",
        "tests/**/*.slow.test.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "apps/km-repl": {
      "entry": ["src/index.ts", "tests/**/*.test.ts", "tests/**/*.test.tsx"],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.tsx"
      ]
    },
    "apps/km-tui": {
      "entry": [
        "src/tui.ts",
        "src/index.ts",
        "tests/**/*.test.ts",
        "tests/**/*.test.tsx",
        "tests/storybook.tsx"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.tsx"
      ]
    },
    "packages/km-agent": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-beads": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-board": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-commands": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-connector-caldav": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-core": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-markdown": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-storage": {
      "entry": [
        "src/index.ts",
        "tests/**/*.test.ts",
        "tests/**/*.slow.test.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-tree": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "vendor/beorn-chalkx": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "vendor/beorn-flexx": {
      "entry": ["src/index.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "vendor/beorn-inkx": {
      "entry": ["src/index.ts", "tests/**/*.test.ts", "tests/**/*.test.tsx"],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.tsx"
      ]
    },
    "vendor/beorn-inkx-ui": {
