{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [".claude/**", "archive/**"],
  "ignoreDependencies": [
    "@beorn/inkx-ui",
    "@beorn/watcher-chaos",
    "@km/agent",
    "@km/beads",
    "@km/board",
    "@km/cli-app",
    "@km/commands",
    "@km/connector-caldav",
    "@km/markdown",
    "@km/repl",
    "@km/tree",
    "@km/tui",
    "@release-it/conventional-changelog",
    "chalkx",
    "oxlint",
    "oxlint-plugin-complexity",
    "oxlint-tsgolint",
    "yaml"
  ],
  "ignoreBinaries": ["nix", "which", "direnv", "eslint", "prettier"],
  "bun": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "release-it.config.js",
        "benchmarks/*.bench.ts",
        "infra/vitest-dotz/index.tsx",
        "website/script.js"
      ],
      "project": [
        "scripts/**/*.ts",
        "benchmarks/**/*.ts",
        "infra/**/*.ts",
        "infra/**/*.tsx",
        "website/**/*.js"
      ]
    },
    "apps/km-cli": {
      "entry": [
        "src/execute.ts",
        "tests/**/*.test.ts",
        "tests/**/*.slow.test.ts",
        "tests/km-repl.ts",
        "tests/mdtest-sh-plugin.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "apps/km-repl": {
      "entry": ["tests/**/*.test.ts"],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "src/**/*.tsx"
      ]
    },
    "apps/km-tui": {
      "entry": [
        "tests/**/*.test.ts",
        "tests/**/*.test.tsx",
        "tests/**/*.bench.ts",
        "tests/storybook.tsx",
        "tests/explore-*.ts",
        "tests/profile-*.ts",
        "tests/perf-*.tsx"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.tsx"
      ]
    },
    "packages/km-agent": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-beads": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-board": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-commands": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-connector-caldav": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-core": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-markdown": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-storage": {
      "entry": [
        "tests/**/*.test.ts",
        "tests/**/*.slow.test.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/km-tree": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "vendor/beorn-chalkx": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "vendor/beorn-flexx": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "vendor/beorn-inkx": {
      "entry": ["tests/**/*.test.ts", "tests/**/*.test.tsx"],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.tsx"
      ]
    },
    "vendor/beorn-inkx-ui": {
      "entry": ["tests/**/*.test.ts"],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "src/**/*.tsx"
      ]
    },
    "vendor/beorn-logger": {
      "project": ["src/**/*.ts"]
    },
    "vendor/beorn-mdtest": {
      "entry": [
        "tests/**/*.test.ts",
        "tests/**/*.slow.test.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "vendor/beorn-tap": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "vendor/beorn-tools": {
      "entry": [
        "tools/*.ts",
        "tests/**/*.test.ts"
      ],
      "project": ["tools/**/*.ts", "tests/**/*.ts"]
    },
    "vendor/beorn-vitestx": {
      "project": ["src/**/*.ts"]
    },
    "vendor/beorn-watcher-chaos": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  }
}
