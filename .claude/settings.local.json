{
  "permissions": {
    "allow": [
      "Bash",
      "Bash:*",
      "Bash(bun km:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "WebSearch",
      "WebFetch",
      "Skill(pm)",
      "Skill(commit)",
      "Skill(git)",
      "Skill(git:*)",
      "Skill(code)",
      "Skill(tui)",
      "Skill(tests)",
      "Skill(explore)",
      "Skill(max)",
      "Skill(max:*)",
      "Skill(recall)",
      "Skill(discuss)",
      "Skill(complete)",
      "Skill(claude)",
      "Skill(logging)",
      "Skill(silvery)",
      "Skill(flexily)",
      "Skill(fresh)",
      "Skill(llm)",
      "Skill(deep)",
      "Skill(playwright-cli)",
      "mcp__tty__start",
      "mcp__tty__screenshot",
      "mcp__tty__press",
      "mcp__tty__reset",
      "mcp__tty__wait",
      "mcp__tty__list",
      "mcp__tty__stop",
      "mcp__tty__type",
      "mcp__tty__text",
      "mcp__termless__start",
      "mcp__termless__screenshot",
      "mcp__termless__press",
      "mcp__termless__stop",
      "mcp__termless__wait",
      "Skill(project-cleanup)",
      "Skill(npm)",
      "Skill(open)",
      "mcp__plugin_telegram_telegram__reply",
      "mcp__tribe__tribe_sessions",
      "mcp__tribe__tribe_send",
      "mcp__tribe__tribe_broadcast",
      "mcp__tribe__tribe_history",
      "mcp__tribe__tribe_rename",
      "mcp__tribe__tribe_health",
      "Skill(tribe)",
      "Skill(update-config)",
      "Skill(release)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sqlite3 .beads/tribe.db \"UPDATE sessions SET claude_session_id = '${CLAUDE_SESSION_ID}' WHERE pid = (SELECT pid FROM sessions ORDER BY started_at DESC LIMIT 1)\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "outputStyle": "default",
  "spinnerTipsEnabled": false,
  "prefersReducedMotion": true
}
