{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:2"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd $CLAUDE_PROJECT_DIR && bun vendor/beorn-tools/tools/recall.ts remember",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
