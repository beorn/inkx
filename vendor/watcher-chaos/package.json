{
  "name": "@beorn/watcher-chaos",
  "version": "0.2.0",
  "description": "Drop-in chaos file watcher for testing — simulates dropped events, reordering, coalescing, atomic writes, and event storms with deterministic replay",
  "keywords": [
    "chaos",
    "chaos-engineering",
    "chokidar",
    "deterministic",
    "file-watching",
    "fsevents",
    "fuzz",
    "inotify",
    "seeded-random",
    "simulation",
    "testing",
    "watcher"
  ],
  "homepage": "https://github.com/beorn/watcher-chaos#readme",
  "bugs": {
    "url": "https://github.com/beorn/watcher-chaos/issues"
  },
  "license": "MIT",
  "author": "beorn",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/watcher-chaos.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "tsdown": {
    "entry": "src/index.ts",
    "format": "esm",
    "dts": true,
    "clean": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.21.7",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
