{
  "name": "@beorn/tap",
  "version": "0.3.0",
  "private": true,
  "description": "TAP stream orchestration: merge parallel test runners, convert formats (Bun JUnit, Playwright), beautiful terminal output",
  "keywords": [
    "bun",
    "ci",
    "junit",
    "merge",
    "orchestration",
    "parallel",
    "playwright",
    "reporter",
    "stream",
    "tap",
    "test",
    "test-anything-protocol",
    "test-runner",
    "testing",
    "vitest"
  ],
  "homepage": "https://github.com/beorn/tap#readme",
  "bugs": {
    "url": "https://github.com/beorn/tap/issues"
  },
  "license": "MIT",
  "author": "Beorn",
  "repository": {
    "type": "git",
    "url": "https://github.com/beorn/tap.git"
  },
  "bin": {
    "tap": "./src/cli/runner.ts"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./consumer": "./src/consumer.ts",
    "./merge": "./src/merge.ts",
    "./orchestrate": "./src/orchestrate.ts",
    "./parallel-tui": "./src/parallel-tui.ts",
    "./producers/bun": "./src/producers/bun.ts",
    "./producers/playwright": "./src/producers/playwright.ts",
    "./producers/vitest": "./src/producers/vitest.ts"
  },
  "scripts": {
    "test": "bun test tests/",
    "test:fast": "bun test tests/ --timeout 5000",
    "test:all": "bun test tests/",
    "typecheck": "tsc --noEmit",
    "example:basic": "bun run examples/basic.ts",
    "example:parallel": "bun run examples/parallel.ts"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "tap-parser": "^18.3.0"
  },
  "engines": {
    "node": ">=23.6.0"
  }
}
